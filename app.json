{
  "expo": {
    "name": "uust-app",
    "slug": "uust-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "jsEngine": "hermes",
      "bundleIdentifier": "com.exile37.uustjournal"
    },
    "android": {
      "package": "com.exile37.uustjournal",
      "jsEngine": "hermes"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "./plugins/withNoApsEnvironment"
    ]
  }
}
