{
  "expo": {
    "name": "uust-app",
    "slug": "uust-app",
    "version": "1.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "jsEngine": "hermes",
      "bundleIdentifier": "com.exile37.uustjournal"
    },
    "android": {
      "package": "com.exile37.uustjournal",
      "jsEngine": "hermes",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1b2a"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "./plugins/withNoApsEnvironment"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1b2a"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
